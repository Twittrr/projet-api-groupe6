# =============================================================
# Breezy — Variables d'environnement (exemple)
# Copier en .env :  cp .env.example .env
# NE JAMAIS commiter le fichier .env réel.
# Générer des secrets : openssl rand -hex 48
# =============================================================

# ---- Général ----
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- JWT (clés de signature des jetons) ----
# OBLIGATOIRE en production — générer avec : openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_dev_access_secret_0123456789abcdef
JWT_REFRESH_SECRET=CHANGE_ME_dev_refresh_secret_9876543210fedcba
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Clé partagée pour les appels internes service-à-service
# OBLIGATOIRE en production — générer avec : openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_dev_internal_key_abcdef

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=breezy
POSTGRES_USER=breezy
POSTGRES_PASSWORD=CHANGE_ME_breezy_pg_password
# Mettre à "true" pour les bases managées qui imposent TLS (ex. Azure Database for PostgreSQL).
POSTGRES_SSL=false

# ---- MongoDB ----
# Credentials utilisés par le container mongo (MONGO_INITDB_ROOT_*)
# et dans l'URI de connexion des services
MONGO_USER=breezy
MONGO_PASSWORD=CHANGE_ME_breezy_mongo_password
MONGO_URI=mongodb://breezy:CHANGE_ME_breezy_mongo_password@mongo:27017/breezy?authSource=admin

# ---- Ports internes des services (réseau Docker) ----
AUTH_PORT=4001
USERS_PORT=4002
POSTS_PORT=4003
NOTIF_PORT=4004
CONV_PORT=4005

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=/api/v1
FRONTEND_PORT=3000

# ---- Gateway (Nginx) ----
GATEWAY_PORT=8080

# ---- Compte administrateur initial (seed) ----
# OBLIGATOIRE en production — changer ce mot de passe avant le premier démarrage
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@breezy.local
SEED_ADMIN_PASSWORD=CHANGE_ME_Admin_Password_123!
